# ---------------------------------------------------------------
# 필수
# ---------------------------------------------------------------
# 세션/CSRF 서명 키. 16자 이상, 예시값 그대로 두면 기동이 거부된다.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# MySQL 접속 주소. docker compose 로 띄우면 app 컨테이너에서는 자동으로 mysql 서비스로 덮어쓴다.
DATABASE_URL=mysql+pymysql://inventory_app:CHANGE_ME@localhost:3306/inventory?charset=utf8mb4

# docker compose 의 mysql 서비스가 읽는 값 (DATABASE_URL 과 일치시킬 것)
MYSQL_DATABASE=inventory
MYSQL_USER=inventory_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------
# 서버
# ---------------------------------------------------------------
HOST=0.0.0.0
PORT=51000
# 1 이면 Flask 개발 서버(자동 리로드). 운영에서는 비워둔다(waitress 로 기동).
FLASK_DEBUG=
WAITRESS_THREADS=8
# HTTPS 뒤에서 운영하면 1 (Secure 쿠키)
SESSION_COOKIE_SECURE=0
# 로그인 시도 제한 저장소. 단일 프로세스면 memory:// 로 충분. 다중 인스턴스면 redis://host:6379
RATELIMIT_STORAGE_URI=memory://

# Docker 첫 실행 시 만들 초기 관리자. 8자 이상의 강한 비밀번호를 지정하세요.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=관리자

# 업로드
UPLOAD_MAX_MB=100
# 비우면 프로젝트 루트의 uploads/ 를 사용
UPLOAD_DIR=

# 기동 시 DB 마이그레이션 자동 적용 (flask db upgrade). 수동으로 관리하려면 0
AUTO_MIGRATE=1

# ---------------------------------------------------------------------------
# 업무 규칙
# ---------------------------------------------------------------------------
# 표시/집계 시간대 (DB 에는 UTC 저장)
APP_TIMEZONE=Asia/Seoul
# 필수수량 칸이 비어 있는 품목의 기준: 필수수량 = 이 값 + 1 (기본 2).
# 품목별 기준은 시트의 '필수수량' 열에서 정한다 — 재고가 그보다 적어지면 모자란 만큼 입고요청 자동 생성
LOW_STOCK_THRESHOLD=1
# 입고요청이 승인 없이 이 일수 이상 지나면 배지/목록에서 '지연' 으로 강조
STOCKREQUEST_STALE_DAYS=3

# ---------------------------------------------------------------------------
# 이메일 알림 (Gmail SMTP, 선택)
#   Google 계정 → 보안 → 2단계 인증 켠 뒤 → 앱 비밀번호 16자리 발급. 일반 비밀번호는 안 됨.
#   알림 종류: 입고요청 생성(수동/자동)·저재고 → 관리자 / 승인·입고완료 → 요청자
#   받는 사람: User.email 이 있는 활성 관리자 + NOTIFY_ADMIN_EMAILS
# ---------------------------------------------------------------------------
NOTIFY_ENABLED=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=StockFlow <you@gmail.com>
NOTIFY_ADMIN_EMAILS=
# 메일 본문 하단에 붙는 서비스 주소 (선택)
APP_BASE_URL=

# ---------------------------------------------------------------
# 로깅
# ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_CONSOLE=1

# ---------------------------------------------------------------
# Gemini AI (선택 — 없으면 AI 채팅만 비활성)
# ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------
# eBay (선택 — 없으면 eBay 가격 조회 비활성)
# ---------------------------------------------------------------
# EBAY_APP_ID  = developer.ebay.com/my/keys → App ID (Client ID)
# EBAY_CERT_ID = 같은 페이지 → Cert ID (Client Secret). Dev ID와 다른 값이니 혼동 주의.
# EBAY_ENV는 발급받은 키셋과 반드시 일치해야 함 (Sandbox 키 ↔ production 설정 조합 절대 금지, 인증 실패함)
# EBAY_MARKETPLACE = EBAY_US 고정 (한국 전용 마켓플레이스(EBAY_KR)는 존재하지 않음)
# EBAY_BUYER_COUNTRY = 배송비/배송가능 여부를 추정받을 구매자 국가 코드 (기본값 KR)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_ENV=production
EBAY_MARKETPLACE=EBAY_US
EBAY_BUYER_COUNTRY=KR
